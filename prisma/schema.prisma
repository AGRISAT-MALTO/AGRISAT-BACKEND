generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Parcelle {
  id                       String   @id @default(uuid()) @db.Uuid
  label                    String
  coordinates              Json
  center_lat               Float
  center_lng               Float
  surface_ha               Float?
  culture_declared         String?
  culture_detected         String?
  ndvi_percentage          Float?
  ndre                     Float?
  spectral_bands           Json?
  confidence               Float?
  verdict                  String?
  details                  String?
  saison                   String?
  soil_type                String?
  risk_factors             Json?
  recommendations          String?
  data_source              String?
  owner_name               String?
  notes                    String?
  time_series_s1           Json?
  time_series_s2           Json?
  time_series_rain         Json?
  estimated_planting_date  String?
  estimated_harvest_date   String?
  days_since_planting     Int?
  growth_stage             String?
  planting_confidence      Float?
  evi                      Float?
  savi                     Float?
  ndwi                     Float?
  agro_score               Float?
  hybrid_score             Float?
  cnn_prob_barley          Float?
  cnn_prob_non_barley      Float?
  created_at               DateTime @default(now()) @db.Timestamptz(6)

  @@index([center_lat, center_lng])
  @@map("parcelles")
}

model FieldScanRun {
  id                    String   @id @default(uuid()) @db.Uuid
  version               String
  center_lat            Float
  center_lng            Float
  radius_m              Float
  image_date            String?
  image_age_days        Int?
  cloud_percentage      Float?
  confidence_threshold  Float
  min_area_ha           Float
  result_geojson        Json
  candidates_found      Int
  candidates_kept       Int
  warnings              Json
  created_at            DateTime @default(now()) @db.Timestamptz(6)

  @@map("field_scan_runs")
}
